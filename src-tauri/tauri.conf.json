{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Nvidia",
  "version": "0.1.0",
  "identifier": "com.nvidia.app",
  "build": {
    "frontendDist": "../static",
    "devUrl": "http://localhost:5000",
    "beforeDevCommand": "",
    "beforeBuildCommand": ""
  },
  "app": {
    "windows": [
      {
        "title": "Nvidia",
        "width": 900,
        "height": 700,
        "resizable": true,
        "fullscreen": false,
        "center": true,
        "visible": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/icon.ico"
    ]
  }
}
